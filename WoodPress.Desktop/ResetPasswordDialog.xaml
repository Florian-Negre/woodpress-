<Window x:Class="WoodPress.Desktop.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réinitialiser le Mot de Passe — WoodPress" 
        Height="310" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtUserTitle" Text="🔑 Réinitialiser le Mot de Passe" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
            <TextBlock Text="Définissez ou générez un nouveau mot de passe sécurisé" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Formulaire -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Nouveau mot de passe :" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPassword" TextChanged="TxtPassword_TextChanged" Padding="8,7" FontSize="13" FontFamily="Consolas"/>
                <Button Grid.Column="1" Content="🎲 Nouveau" Click="BtnGenerate_Click" Background="#334155" Padding="10,6" Margin="6,0,0,0"/>
            </Grid>

            <!-- Niveau de Sécurité -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Niveau de sécurité : " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBlock x:Name="TxtStrength" Text="Fort 🟢" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Annuler" Click="BtnCancel_Click" Background="#334155" Margin="0,0,8,0"/>
            <Button Content="💾 Enregistrer le Mot de Passe" Click="BtnSave_Click" Background="{StaticResource AccentGreen}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
