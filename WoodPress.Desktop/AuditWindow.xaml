<Window x:Class="WoodPress.Desktop.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit, Santé &amp; Utilisateurs — WoodPress" 
        Height="640" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="🔍 Audit &amp; Gestion du Site" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                <TextBlock x:Name="TxtSubtitle" Text="Analyse en cours..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Badge Score de Santé -->
            <Border Grid.Column="1" x:Name="BrdHealthScore" Background="#1e293b" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1.5" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Santé : " Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtHealthScore" Text="100% 🛡️" Foreground="{StaticResource AccentGreen}" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bannière Alerte Mise à Jour Core WordPress -->
        <Border Grid.Row="1" x:Name="BrdCoreUpdate" Background="#332200" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCoreUpdateMsg" Text="⚡ Une nouvelle version officielle de WordPress est disponible !" Foreground="#fbbf24" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Mise à jour recommandée pour bénéficier des derniers correctifs de sécurité et performances." Foreground="#d1d5db" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnUpdateWpCore" Content="⚡ Mettre à jour WordPress" Click="BtnUpdateWpCore_Click" Background="#d97706" Padding="12,6" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Onglets Extensions, Thèmes & Utilisateurs -->
        <TabControl Grid.Row="2">
            <TabItem Header="🧩 Extensions (Plugins)">
                <DataGrid x:Name="GridPlugins" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#1e293b" RowBackground="#0f172a" AlternatingRowBackground="#1e293b"
                          Foreground="#ffffff" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155" BorderBrush="#334155" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Extension" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Version Locale" Binding="{Binding LocalVersion}" Width="110"/>
                        <DataGridTextColumn Header="Dernière WP.org" Binding="{Binding RemoteVersion}" Width="120"/>
                        <DataGridTextColumn Header="Statut &amp; Santé" Binding="{Binding Status}" Width="1.8*"/>
                        <DataGridTextColumn Header="Niveau de Risque" Binding="{Binding RiskLevel}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🎨 Thèmes">
                <DataGrid x:Name="GridThemes" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#1e293b" RowBackground="#0f172a" AlternatingRowBackground="#1e293b"
                          Foreground="#ffffff" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155" BorderBrush="#334155" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thème" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Version Locale" Binding="{Binding LocalVersion}" Width="110"/>
                        <DataGridTextColumn Header="Dernière WP.org" Binding="{Binding RemoteVersion}" Width="120"/>
                        <DataGridTextColumn Header="Statut &amp; Santé" Binding="{Binding Status}" Width="1.8*"/>
                        <DataGridTextColumn Header="Auteur" Binding="{Binding Author}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="👥 Utilisateurs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'action Utilisateurs -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Ajouter un Utilisateur" Click="BtnAddUser_Click" Background="{StaticResource AccentGreen}" Padding="12,6" FontWeight="Bold"/>
                        <Button Content="🔄 Rafraîchir les Comptes" Click="BtnRefreshUsers_Click" Background="#334155" Padding="12,6" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Tableau des Comptes Utilisateurs -->
                    <DataGrid Grid.Row="1" x:Name="GridUsers" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="#1e293b" RowBackground="#0f172a" AlternatingRowBackground="#1e293b"
                              Foreground="#ffffff" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155" BorderBrush="#334155" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Identifiant" Binding="{Binding Login}" Width="1.5*"/>
                            <DataGridTextColumn Header="Adresse Email" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🔑 Reset MDP" Click="BtnResetPassword_Click" Tag="{Binding}" Background="#3b82f6" Padding="6,4" FontSize="11" Margin="2,0"/>
                                            <Button Content="🗑️ Supprimer" Click="BtnDeleteUser_Click" Tag="{Binding}" Background="#ef4444" Padding="6,4" FontSize="11" Margin="2,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bouton Fermer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Fermer" Click="BtnClose_Click" Background="#334155" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
