<Window x:Class="WoodPress.Desktop.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un Nouveau Projet WordPress — WoodPress" 
        Height="660" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="➕ Nouveau Projet WordPress" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
            <TextBlock Text="Initialisation de l'environnement Docker &amp; Ports personnalisables" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Nom du Client" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtClientName" Padding="8" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                <TextBlock Text="Nom du Projet / Slug (ex: vk-interiordesign)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtProjectSlug" Padding="8" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                <TextBlock Text="Espace de Travail" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CboWorkspace" Padding="8" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12">
                    <ComboBoxItem Content="Workspace Pro (G:\Workspace)" IsSelected="True"/>
                    <ComboBoxItem Content="Learnspace WordPress (E:\E-Dev\WordPress)"/>
                </ComboBox>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Version WordPress" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWpVersion" Text="7.0.4" Padding="8" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Version PHP" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboPhpVersion" Padding="6" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}">
                            <ComboBoxItem Content="8.5 (Dernière version)" IsSelected="True"/>
                            <ComboBoxItem Content="8.4 (Stable recommandée)"/>
                            <ComboBoxItem Content="8.3"/>
                            <ComboBoxItem Content="8.2"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- SECTION CONFIGURATION DES PORTS DOCKER -->
                <Border Background="#0f172a" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔌 Attribution des Ports Docker (Modifiables)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Port Web HTTP" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtPortHttp" Padding="6" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Port BDD MySQL" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtPortDb" Padding="6" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Port PhpMyAdmin" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtPortPma" Padding="6" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Port Mailpit" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtPortMail" Padding="6" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkPma" Content="Activer PhpMyAdmin GUI" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkMailpit" Content="Activer Mailpit Serveur Email" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Click="BtnCancel_Click" Background="#334155" Margin="0,0,8,0"/>
            <Button Content="🚀 Créer le Projet" Click="BtnCreate_Click" Background="{StaticResource AccentGreen}"/>
        </StackPanel>
    </Grid>
</Window>
